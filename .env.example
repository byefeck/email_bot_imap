# Токен Telegram-бота (получить у @BotFather)
TOKEN=

# Строка подключения к БД (SQLAlchemy + async-драйвер).
# Локально — SQLite, поднимать ничего не нужно:
#   DATABASE_URL=sqlite+aiosqlite:///./local.db
# В проде — PostgreSQL (поднимается в docker-compose.yml сервисом `db`):
DATABASE_URL=postgresql+asyncpg://email_bot:email_bot@db:5432/email_bot

# Ключ шифрования паролей пользователей (cryptography.fernet).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Публичный HTTPS-адрес веб-формы подключения почты, БЕЗ слэша на конце.
# На него ведёт inline-кнопка "Подключить почту" в боте.
#   Прод:    https://your-domain.com
#   Локально: адрес, который выдаст ngrok (см. README), например https://xxxx.ngrok-free.app
WEB_BASE_URL=
